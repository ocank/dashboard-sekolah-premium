# Salin file ini menjadi .env.local untuk pengembangan lokal,
# dan isi nilai yang sama di Vercel (Project Settings > Environment Variables).
#
# Ambil dari Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-supabase-di-sini
